NODE_ENV=development
PORT=3001
DATABASE_URL=file:./prisma/dev.db
CORS_ORIGINS=http://localhost:3000

# Autenticación Bearer. En producción JWT_SECRET es obligatorio.
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
AUTH_TOKEN_TTL_SECONDS=7200

# Bootstrap del primer superadmin (ejecutar una sola vez)
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=cambiar-por-una-contraseña-temporal-segura
SUPERADMIN_NOMBRE=Superadministrador

MUNICIPIO_URL=http://municipio:3005
BANCO_URL=http://banco:3002
BILLETERA_URL=http://billetera:3006
ARBA_URL=http://arba:3003
ARCA_URL=http://arca:3004

# Bloqueo persistido por venta. Debe superar la duración máxima del flujo.
VENTA_LOCK_TTL_MS=30000

MUNICIPIO_MOCK=false
BANCO_MOCK=false
BILLETERA_MOCK=false
ARBA_MOCK=false
ARCA_MOCK=false
