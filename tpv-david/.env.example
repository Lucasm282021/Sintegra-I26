# Puerto en el que corre este servicio (según el contrato común, TPV = 3001)
PORT=3001

NODE_ENV=development

# --- Integración con Banco ---
BANCO_URL=http://localhost:3002
# Si Banco todavía no está corriendo de tu lado, poné esto en true para
# simular el cobro sin llamar al servicio real (útil para seguir probando).
BANCO_MOCK=true

# --- Integración con ARBA ---
ARBA_URL=http://localhost:3003
# Igual que con Banco: simula la percepción de IIBB (alícuota fija del 5%)
# sin llamar al servicio real de ARBA.
ARBA_MOCK=true

# --- Integración con ARCA ---
ARCA_URL=http://localhost:3004
# ARCA todavía NO tiene dueño confirmado en la cátedra (conflicto sin resolver
# entre otros alumnos). Dejalo en true hasta que se sepa quién lo construye.
ARCA_MOCK=true
# --- Integración con Municipio (habilitación de comercios) ---
MUNICIPIO_URL=http://localhost:3005
# true: simula la habilitación sin llamar al servicio real de Municipio.
MUNICIPIO_MOCK=true

# --- Billetera (todavía no interviene en la venta, solo en "Conexiones") ---
BILLETERA_URL=http://localhost:3006
BILLETERA_MOCK=true

# Carpeta donde se guardan productos.json y ventas.json.
# En Vercel solo se puede escribir en /tmp: DATA_DIR=/tmp/tpv-data
# DATA_DIR=./data
