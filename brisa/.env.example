# TPV de Brisa · variables de entorno
# Copiar como .env solo si se quiere cambiar algo. Sin .env se usan estos valores.

# Puerto donde escucha el TPV (contrato: 3001)
PORT=3001

# Archivo de la base SQLite propia del TPV (se crea solo)
DB_PATH=data/tpv.db

# Servicios del ecosistema. Dentro de Docker Compose usar el nombre del servicio, no localhost.
MUNICIPIO_URL=http://municipio:3005
ARBA_URL=http://arba:3003
BANCO_URL=http://banco:3002
BILLETERA_URL=http://billetera:3006
ARCA_URL=http://arca:3004

# Tiempo máximo de espera por cada llamada a otro servicio (milisegundos)
HTTP_TIMEOUT_MS=5000

# Tipo de comprobante que se pide a ARCA: FACTURA_A, FACTURA_B o FACTURA_C
TIPO_COMPROBANTE=FACTURA_B

# Solo para docker-compose.yml de esta carpeta (demo local)
TPV_PUERTO_HOST=3001
SIMULADORES_PUERTO_HOST=3099
